# ==========================================================================
# Konfiguration fuer Apache-Webserver (die meisten Webhosting-Pakete)
# Laeuft der Webserver nicht mit Apache, kann diese Datei entfallen.
# ==========================================================================

# ---- Zeichensatz ---------------------------------------------------------
AddDefaultCharset UTF-8

# ---- Eigene Fehlerseite --------------------------------------------------
ErrorDocument 404 /404.html

# ---- Verzeichnisauflistung unterbinden -----------------------------------
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ---- Weiterleitung auf HTTPS -------------------------------------------
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # ---- Einheitliche Domain mit www ---------------------------------------
  # Falls die Seite ohne "www" laufen soll, diese beiden Zeilen entfernen
  # und stattdessen die Variante darunter aktivieren.
  RewriteCond %{HTTP_HOST} ^hanau-urologie\.de$ [NC]
  RewriteRule ^ https://www.hanau-urologie.de%{REQUEST_URI} [R=301,L]

  # Variante ohne "www":
  # RewriteCond %{HTTP_HOST} ^www\.hanau-urologie\.de$ [NC]
  # RewriteRule ^ https://hanau-urologie.de%{REQUEST_URI} [R=301,L]
</IfModule>

# ---- Sicherheits-Header --------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), interest-cohort=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Content-Security-Policy: Die Seite laedt ausschliesslich eigene Ressourcen.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'"
  # HSTS erst aktivieren, wenn HTTPS dauerhaft und fehlerfrei laeuft:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ---- Komprimierung -------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---- Browser-Zwischenspeicher --------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 1 hour"
  ExpiresByType text/css                  "access plus 1 month"
  ExpiresByType application/javascript    "access plus 1 month"
  ExpiresByType image/svg+xml             "access plus 1 month"
  ExpiresByType image/jpeg                "access plus 1 month"
  ExpiresByType image/png                 "access plus 1 month"
  ExpiresByType image/webp                "access plus 1 month"
</IfModule>
